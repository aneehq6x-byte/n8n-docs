# Copy to .env and fill in. NEVER commit .env.
UMIP_ENV=dev                      # dev | staging | prod
POSTGRES_PASSWORD=change-me
UMIP_DATABASE_URL=sqlite+aiosqlite:///./umip.db

# Telegram (create the bot with @BotFather; use the test environment first)
UMIP_TELEGRAM_BOT_TOKEN=
UMIP_TELEGRAM_USE_TEST_ENV=true
UMIP_TELEGRAM_WEBHOOK_SECRET=     # random 32+ chars; sent by Telegram in X-Telegram-Bot-Api-Secret-Token
UMIP_TELEGRAM_WEBHOOK_URL=        # https://your-domain/telegram/webhook
UMIP_PRIVATE_CHANNEL_ID=          # e.g. -100xxxxxxxxxx ; bot must be admin with invite + ban rights
UMIP_PUBLIC_CHANNEL_ID=

# Random 32+ chars. Signs invoice payloads.
UMIP_PAYLOAD_SIGNING_KEY=

# Admin API keys -> roles (admin | analyst | support). JSON.
UMIP_ADMIN_API_KEYS={}

# Market data: mock (tests/demo only) | massive
UMIP_MARKET_DATA_PROVIDER=mock
UMIP_MASSIVE_API_KEY=

# Signals: human_approval (default) | automatic
UMIP_PUBLISH_MODE=human_approval

# Optional AI assistant
UMIP_ANTHROPIC_API_KEY=
UMIP_AI_MODEL=claude-opus-5-5
