# Copy to .env (repo root) and to apps/web/.env.local for Next.js.
DATABASE_URL=postgres://tenderpilot:tenderpilot@localhost:5432/tenderpilot
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
NEXTAUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tender-documents
S3_ACCESS_KEY=tenderpilot
S3_SECRET_KEY=tenderpilot-secret

# Scout: comma-separated connectors (etimad-mock is fixture-backed).
SCOUT_CONNECTORS=etimad-mock
SCOUT_CRON=0 */6 * * *
SCOUT_LOOKBACK_DAYS=90

# env | azure-keyvault
SECRETS_PROVIDER=env
# AZURE_KEYVAULT_URL=https://tenderpilot-prod.vault.azure.net
