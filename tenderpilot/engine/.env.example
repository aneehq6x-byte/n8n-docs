# --- Credentials -------------------------------------------------------------
# Claude API (provider=anthropic). Alternatively run `ant auth login`.
ANTHROPIC_API_KEY=

# Microsoft Foundry (provider=foundry) keeps tender data inside your Azure tenancy.
# TP_PROVIDER=foundry
# TP_FOUNDRY_RESOURCE=my-foundry-resource
# ANTHROPIC_FOUNDRY_API_KEY=

# --- Model routing (per task) ------------------------------------------------
# TP_MODEL=claude-opus-5-5          # default for every task
# TP_EXTRACT_EFFORT=high            # low | medium | high | xhigh | max
# TP_EXTRACT_MAX_TOKENS=64000
# TP_ASSESS_EFFORT=medium
# TP_ASSESS_MAX_TOKENS=32000

# --- Limits ------------------------------------------------------------------
# TP_MAX_UPLOAD_MB=32
# TP_MAX_PAGES=600
# TP_ENABLE_FALLBACKS=true          # server-side refusal fallbacks (Claude API only)
