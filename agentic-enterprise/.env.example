# مثال لمتغيرات البيئة: انسخ هذا الملف إلى .env ولا تضع فيه أي مفتاح حقيقي داخل المستودع.

# مفتاح Claude: مطلوب فقط لوضع التشغيل الحي (live). الاختبارات الحتمية لا تحتاجه.
ANTHROPIC_API_KEY=

# النموذج المستخدم للوكلاء في الوضع الحي
AGENT_MODEL=claude-opus-5-5

# وضع التشغيل: scripted (حتمي، بلا نموذج) أو live (Claude Agent SDK)
AGENT_RUNTIME=scripted

# مسار قاعدة البيانات (SQLite). استخدم :memory: للاختبارات
DATABASE_PATH=./data/enterprise.db

# مفتاح الإيقاف الطارئ: true يوقف كل الوكلاء فورًا
KILL_SWITCH=false
# ملف علَم بديل: وجود هذا الملف يوقف كل الوكلاء أيضًا
KILL_SWITCH_FILE=./data/KILL_SWITCH

# سياسة الموافقات
APPROVAL_TTL_HOURS=24
DUAL_APPROVAL_THRESHOLD_USD=50000

# حدود الإنفاق لكل تشغيل وكيل (الوضع الحي)
AGENT_MAX_TURNS=20
AGENT_MAX_BUDGET_USD=2

# مهلة تشغيل الوكيل الواحد بالمللي ثانية. بعدها يُلغى التشغيل ويُعاد الطابور بتأخير متصاعد.
AGENT_TIMEOUT_MS=300000

# تثبيت audit خارج القاعدة: مفتاح HMAC (32 بايت، hex أو base64) من مدير الأسرار، وملف على وحدة منفصلة.
# توليد مفتاح للتطوير: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_ANCHOR_KEY=
AUDIT_ANCHOR_FILE=./data/audit-anchor.jsonl
# true يرفض الإقلاع دون مفتاح. إلزامي في الإنتاج.
AUDIT_ANCHOR_REQUIRED=false
